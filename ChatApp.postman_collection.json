                "me"
              ]
            }
          }
        },
        {
          "name": "Get All Other Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/users",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Update FCM Token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fcmToken\": \"your_device_fcm_token_here\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/users/fcm-token",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
