          }
        },
        {
          "name": "Test Push Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Test Title\",\n    \"body\": \"This is a test notification\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/users/test-push",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
